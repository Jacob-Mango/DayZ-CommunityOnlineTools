    <Widget Name="CheckBoxWidget">
        <Style Name="Default" Font="gui/fonts/MetronBook" ImageSet="ccgui_enforce" Color="4294967295">
            <State Name="Normal">
                <Item Name="CheckBox" Image="CheckboxNormal" />
            </State>
            <State Name="Disabled">
                <Item Name="CheckBox" Image="CheckboxDisabled" />
            </State>
            <State Name="Mark">
                <Item Name="CheckBox" Image="MarkDone" />
            </State>
            <State Name="Highlight">
                <Item Name="CheckBox" Image="CheckboxHover" />
            </State>
        </Style>
        <Style Name="NewStyle" Font="gui/fonts/MetronBook" ImageSet="dayz_gui" Color="4294967295">
            <State Name="Disabled">
                <Item Name="CheckBox" Image="icon_locked_sb" />
            </State>
            <State Name="Highlight">
                <Item Name="CheckBox" Image="icon_favourite_off" />
            </State>
            <State Name="Mark">
                <Item Name="CheckBox" Image="icon_favourite_on" />
            </State>
            <State Name="Normal">
                <Item Name="CheckBox" Image="icon_favourite_off" />
            </State>
        </Style>
        <Style Name="Editor" Font="gui/fonts/MetronBook" ImageSet="dayz_gui" Color="4294967295">
            <State Name="Disabled">
                <Item Name="CheckBox" Image="InventoryGridCenter" />
            </State>
            <State Name="Highlight">
                <Item Name="CheckBox" Image="InventoryGridEmpty_" />
            </State>
            <State Name="Mark">
                <Item Name="CheckBox" Image="Expand" />
            </State>
            <State Name="Normal">
                <Item Name="CheckBox" Image="InventoryGridEmpty_" />
            </State>
        </Style>
        <Style Name="ServerBrowserExpand" Font="gui/fonts/MetronBook" ImageSet="dayz_gui" Color="4294967295">
            <State Name="Disabled">
                <Item Name="CheckBox" Image="" />
            </State>
            <State Name="Highlight">
                <Item Name="CheckBox" Image="" />
            </State>
            <State Name="Mark">
                <Item Name="CheckBox" Image="icon_expand" />
            </State>
            <State Name="Normal">
                <Item Name="CheckBox" Image="icon_collapse" />
            </State>
        </Style>
        <!-- CheckBoxWidget does NOT use the nine-slice item names (LeftTop/Top/
             Center/...) that PanelWidget, ButtonWidget and EditBoxWidget use. It
             draws exactly one item, named "CheckBox", per state. A style built
             from nine-slice items therefore resolves to nothing and the box is
             invisible even though the widget still toggles. -->
        <Style Name="COTCheckbox" Font="" ImageSet="ccgui_enforce" Color="4294967295">
            <State Name="Normal">
                <Item Name="CheckBox" Image="CheckboxNormal" />
            </State>
            <State Name="Highlight">
                <Item Name="CheckBox" Image="CheckboxHover" />
            </State>
            <State Name="Mark">
                <Item Name="CheckBox" Image="MarkDone" />
            </State>
            <State Name="Disabled">
                <Item Name="CheckBox" Image="CheckboxDisabled" />
            </State>
        </Style>
    </Widget>
