<WidgetStyles>
    <!--
        COTSurface
        ============
        The standard surface for COT panels and containers: form bodies,
        window chrome, split panels, list entries.  Nine-sliced from cot_gui's
        box8 art, so the 8px corner radius holds at any panel size; the
        widget's Color is multiplied with it.

        Default fill colour:
            0xE6191E24 = JMTheme.SURFACE_BASE, daisyUI dark base-200 at 90%.
            30 of the 46 consumers set no colour of their own and inherit this,
            so it has to track the theme -- it carried a pre-daisyUI navy
            (0xF0141B26) through the theme conversion because it lives in XML
            rather than in JMTheme.c.

        Per-widget overrides:
            A widget that declares `style COTSurface` can override the colour
            with `color R G B A` in the layout (or SetColor() in script).

        Mandatory widget contexts:
            DayZ resolves styles by (widget class, style name).  COTSurface
            must therefore be defined separately under EVERY widget type that
            references it.  Missing a context here = engine crash on first
            render of that widget type, because the engine dereferences a null
            state lookup.

            Current consumer widget types (audited from the layout tree):
                PanelWidget          - the majority of cases
                GridSpacerWidget     - JMServerInfoForm root
                WrapSpacerWidget     - reserved (no current consumer)
                ScrollWidget         - reserved (no current consumer)

            FrameWidget does NOT support styles in vanilla DayZ; layouts that
            put `style COTSurface` on a FrameWidgetClass are bugs and should
            either remove the style or change to PanelWidgetClass.
    -->
    <Widget Name="PanelWidget">
        <Style Name="COTSurface" Font="" ImageSet="cot_gui" Color="3860405796">
            <State Name="Normal">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
            <State Name="Disabled">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
        </Style>


        <!--
            SPIKE variant B - nine-slice via the COT IMAGESET (the vanilla way).
            Slices come from JM/COT/GUI/imagesets/cot_gui.imageset, which is
            hand-authored: .edds is a plain DDS (Pillow writes DXT5), and the
            {GUID} on the texture path is not authoritative - four vanilla
            imagesets, rover_imageset included, carry a GUID that disagrees with
            their own .meta and still resolve.
        -->
        <Style Name="COTBox8Set" Font="" ImageSet="cot_gui" Color="4294967295">
            <State Name="Normal">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
            <State Name="Disabled">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
        </Style>

        <Style Name="COTBox8LineSet" Font="" ImageSet="cot_gui" Color="4294967295">
            <State Name="Normal">
                <Item Name="LeftTop" Image="box8_line_lefttop" />
