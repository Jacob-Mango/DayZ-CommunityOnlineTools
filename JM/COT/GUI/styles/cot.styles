                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
            <State Name="Pushed">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
            <State Name="Highlight">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
            <State Name="Focus">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
            <State Name="Disabled">
                <Item Name="LeftTop" Image="box8_lefttop" />
                <Item Name="Top" Image="box8_top" />
                <Item Name="RightTop" Image="box8_righttop" />
                <Item Name="Right" Image="box8_right" />
                <Item Name="RightBottom" Image="box8_rightbottom" />
                <Item Name="Bottom" Image="box8_bottom" />
                <Item Name="LeftBottom" Image="box8_leftbottom" />
                <Item Name="Center" Image="box8_center" />
                <Item Name="Left" Image="box8_left" />
            </State>
        </Style>
    </Widget>

    <!--
        COTInput
        ========
        Vanilla's EditBoxWidget "Default" paints dayz_gui's `area_focus` into
        the Center slice on focus - the red wash every COT input was showing.
        This replaces it: nothing at rest, and on focus a field4 ring in the
        primary colour, matching the ring the base class paints on hover.

        A Style carries ONE Color for all its states, which is why the resting
        and disabled states draw no image at all rather than a dimmer ring.
    -->
    <Widget Name="EditBoxWidget">
        <Style Name="COTInput" Font="gui/fonts/sdf_MetronLight24" ImageSet="cot_gui" Color="4284505599">
            <State Name="Normal">
                <Item Name="LeftTop" Image="" />
                <Item Name="Top" Image="" />
                <Item Name="RightTop" Image="" />
                <Item Name="Right" Image="" />
                <Item Name="RightBottom" Image="" />
                <Item Name="Bottom" Image="" />
                <Item Name="LeftBottom" Image="" />
                <Item Name="Center" Image="" />
                <Item Name="Left" Image="" />
            </State>
            <State Name="Focus">
                <Item Name="LeftTop" Image="field4_line_lefttop" />
                <Item Name="Top" Image="field4_line_top" />
                <Item Name="RightTop" Image="field4_line_righttop" />
                <Item Name="Right" Image="field4_line_right" />
                <Item Name="RightBottom" Image="field4_line_rightbottom" />
                <Item Name="Bottom" Image="field4_line_bottom" />
                <Item Name="LeftBottom" Image="field4_line_leftbottom" />
                <Item Name="Center" Image="field4_line_center" />
                <Item Name="Left" Image="field4_line_left" />
            </State>
            <State Name="Disabled">
                <Item Name="LeftTop" Image="" />
                <Item Name="Top" Image="" />
                <Item Name="RightTop" Image="" />
                <Item Name="Right" Image="" />
                <Item Name="RightBottom" Image="" />
                <Item Name="Bottom" Image="" />
                <Item Name="LeftBottom" Image="" />
                <Item Name="Center" Image="" />
                <Item Name="Left" Image="" />
            </State>
        </Style>
    </Widget>

    <Widget Name="CheckBoxWidget">
        <!-- CheckBoxWidget does NOT use the nine-slice item names (LeftTop/Top/
             Center/...) that PanelWidget, ButtonWidget and EditBoxWidget use. It
             draws exactly one item, named "CheckBox", per state. A style built
             from nine-slice items therefore resolves to nothing and the box is
             invisible even though the widget still toggles. -->
        <Style Name="COTCheckbox" Font="" ImageSet="ccgui_enforce" Color="4294967295">
            <State Name="Normal">
                <Item Name="CheckBox" Image="CheckboxNormal" />
            </State>
            <State Name="Highlight">
                <Item Name="CheckBox" Image="CheckboxHover" />
            </State>
            <State Name="Mark">
                <Item Name="CheckBox" Image="MarkDone" />
            </State>
            <State Name="Disabled">
                <Item Name="CheckBox" Image="CheckboxDisabled" />
            </State>
        </Style>
    </Widget>
</WidgetStyles>

