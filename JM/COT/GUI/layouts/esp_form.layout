PanelWidgetClass JMESPForm {
 color 0 0 0 0
 position 0 0
 size 700 500
 hexactpos 0
 vexactpos 0
 hexactsize 1
 vexactsize 1
 scriptclass "JMESPForm"
 style COTSurface
 {
  FrameWidgetClass panel_top {
   position 0 0
   size 1 180
   halign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 1
  }
  PanelWidgetClass panel_bottom {
   color 0 0 0 0
   position 0 180
   size 1 320
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 1
   {
    FrameWidgetClass panel_bottom_tabs {
     ignorepointer 0
     position 0 0
     size 1 34
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
    }
    FrameWidgetClass panel_bottom_content {
     ignorepointer 0
     position 0 34
     size 1 286
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     {
      FrameWidgetClass esp_filters_panel {
       position 0 0
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
      }
      FrameWidgetClass esp_selected_panel {
       position 0 0
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
      }
     }
    }
   }
  }
 }
}
