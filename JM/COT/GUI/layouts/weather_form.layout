PanelWidgetClass JMWeatherForm {
 ignorepointer 1
 color 0 0 0 0
 position 0 0
 size 900 640
 hexactpos 0
 vexactpos 0
 hexactsize 1
 vexactsize 1
 draggable 1
 scriptclass "JMWeatherForm"
 style COTSurface
 {
  PanelWidgetClass panel_right {
   color 0 0 0 0
   position 0 0
   size 1 1
   halign left_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    FrameWidgetClass panel_right_tabs {
     ignorepointer 0
     position 0 0
     size 1 0.06
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
    }
    PanelWidgetClass mode_banner {
     ignorepointer 1
     position 0 0.06
     size 1 0.05
     halign left_ref
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     color 0.376 0.365 1.000 1.000
     style COTPill6Set
     {
      TextWidgetClass mode_banner_text {
       ignorepointer 1
       position 0 0
       size 0.8 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text ""
       font "gui/fonts/sdf_MetronLight24"
       "exact text" 1
       "exact text size" 14
       "bold text" 1
       "text halign" left
       "text valign" center
       "text offset" 12 0
      }
      ButtonWidgetClass mode_banner_save {
       ignorepointer 0
       visible 0
       color 0 0 0 0
       position 38 0
       size 22 22
       halign right_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       style Empty
       {
        PanelWidgetClass mode_banner_save_hover {
         ignorepointer 1
         visible 0
         position 0 0
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         color 1.000 1.000 1.000 0.180
         style COTPill6Set
        }
        ImageWidgetClass mode_banner_save_icon {
         ignorepointer 1
         position 0 0
         size 15 15
         halign center_ref
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         mode blend
         "src alpha" 1
         "no wrap" 1
         "clamp mode" clamp
         "stretch mode" stretch_w_h
        }
       }
      }
      ButtonWidgetClass mode_banner_close {
       ignorepointer 0
       visible 0
       color 0 0 0 0
       position 10 0
       size 22 22
       halign right_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       style Empty
       {
        PanelWidgetClass mode_banner_close_hover {
         ignorepointer 1
         visible 0
         position 0 0
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         color 1.000 1.000 1.000 0.180
         style COTPill6Set
        }
        ImageWidgetClass mode_banner_close_icon {
         ignorepointer 1
         position 0 0
         size 15 15
         halign center_ref
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         mode blend
         "src alpha" 1
         "no wrap" 1
         "clamp mode" clamp
         "stretch mode" stretch_w_h
        }
       }
      }
     }
    }
    FrameWidgetClass panel_right_content {
     ignorepointer 0
     position 0 0.11
     size 1 0.89
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     {
      FrameWidgetClass tab_overview {
       ignorepointer 0
