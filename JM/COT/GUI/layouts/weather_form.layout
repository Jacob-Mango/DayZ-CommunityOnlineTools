PanelWidgetClass JMWeatherForm {
 color 0 0 0 0
 position 0 0
 size 700 600
 hexactpos 0
 vexactpos 0
 hexactsize 1
 vexactsize 1
 scriptclass "JMWeatherForm"
 style COTSurface
 {
  PanelWidgetClass panel_left {
   color 0 0 0 0
   position 0 0
   size 0.25 1
   halign left_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style COTSurface
   {
    ScrollWidgetClass list_scroller {
     position 0 35
     size 1 525
     halign center_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     style blank
     "Scrollbar V" 1
     {
      GridSpacerWidgetClass list_container {
       position 0 0
       size 1 1
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       "Size To Content V" 1
       Columns 1
       Rows 100
       }
      }
     }
    TextWidgetClass title {
     position 5 10
     size 1 20
     halign left_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Presets"
     font "gui/fonts/sdf_MetronLight24"
     "exact text" 1
     "exact text size" 16
    }
    TextWidgetClass count {
     position 5 10
     size 1 20
     halign right_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "N/A Total"
     font "gui/fonts/sdf_MetronLight24"
     "exact text" 1
     "exact text size" 16
     "text halign" right
    }
   }
  }
  PanelWidgetClass panel_right {
   color 0 0 0 0
   position 0.25 0
   size 0.75 1
   halign left_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    ScrollWidgetClass actions_scroller {
     position 0 0
     size 1 1
     halign center_ref
     valign bottom_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style blank
     "Scrollbar V" 1
     {
      GridSpacerWidgetClass actions_wrapper {
       position 0 0
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       "Size To Content V" 1
       Columns 1
       Rows 1000
      }
     }
    }
   }
  }
 }
}
