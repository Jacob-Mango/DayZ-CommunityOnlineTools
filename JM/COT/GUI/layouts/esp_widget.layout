GridSpacerWidgetClass JMESPWidgetHandler {
 ignorepointer 1
 color 0.098 0.118 0.141 0.985
 size 300 22
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 scriptclass "JMESPWidgetHandler"
 style Colorable
 "Size To Content V" 1
 Columns 1
 Rows 1
 {
  PanelWidgetClass esp_object_header {
   visible 1
   ignorepointer 0
   position 0 0
   size 1 22
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   {
    PanelWidgetClass esp_object_accent {
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 3 1
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 0
    }
    ImageWidgetClass esp_health_level_icon {
     visible 1
     clipchildren 0
     inheritalpha 0
     ignorepointer 1
     color 0.000 0.827 0.565 1.000
     position 11 0
     size 10 10
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     image0 "set:dayz_gui image:circle"
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
     filter 1
    }
    TextWidgetClass esp_object_name {
     ignorepointer 1
     position 27 0
     size 1 18
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text ""
     font "gui/fonts/sdf_MetronLight72"
     "exact text" 1
     "exact text size" 18
     "text halign" left
     "text valign" center
     "size to text h" 1
     "size to text v" 0
    }
    ImageWidgetClass esp_icon_selected {
     visible 0
     inheritalpha 0
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 14 14
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
     filter 1
    }
    ImageWidgetClass esp_icon_state {
     visible 0
     inheritalpha 0
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 14 14
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
     filter 1
    }
    ImageWidgetClass esp_icon_drag {
     visible 0
     inheritalpha 0
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 14 14
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
     filter 1
    }
   }
  }
 }
}
