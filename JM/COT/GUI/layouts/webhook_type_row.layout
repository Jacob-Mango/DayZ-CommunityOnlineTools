PanelWidgetClass webhook_type_row {
 color 0 0 0 0
 position 0 0
 size 1 32
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 {
  FrameWidgetClass type_toggle_slot {
   position 20 0
   size 48 32
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
  }
  TextWidgetClass type_name {
   ignorepointer 1
   position 76 0
   size 0.7 32
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 16
   "text valign" center
  }
  FrameWidgetClass type_delete_slot {
   position 0 0
   size 32 32
   halign right_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
  }
 }
}
