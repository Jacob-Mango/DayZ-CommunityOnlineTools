PanelWidgetClass UIActionMultiSelectList {
 size 1 170
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style rover_sim_colorable
 scriptclass "UIActionMultiSelectList"
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    GridSpacerWidgetClass action_rows_outer {
     ignorepointer 1
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
     Columns 1
     Rows 2
     Padding 0
     {
      TextWidgetClass action_label {
       size 1 20
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 1
       text "{LABEL}"
       font "gui/fonts/sdf_MetronLight24"
       "text offset" 10 0
       "bold text" 1
       "exact text" 1
       "exact text size" 16
       "text valign" center
      }
      GridSpacerWidgetClass action_list_container {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       "Size To Content V" 1
       Columns 1
       Rows 1
       Padding 0
      }
     }
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}
