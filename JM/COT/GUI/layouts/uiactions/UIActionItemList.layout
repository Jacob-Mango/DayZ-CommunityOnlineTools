 vexactsize 0
 color 0 0 0 0
 scriptclass "UIActionItemList"
 {
  PanelWidgetClass list_frame {
   ignorepointer 1
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
