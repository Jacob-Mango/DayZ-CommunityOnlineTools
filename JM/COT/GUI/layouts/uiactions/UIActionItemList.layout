   hexactsize 0
   vexactsize 0
   color 0.082 0.098 0.118 0.949
   style COTField4Set
  }
  PanelWidgetClass list_body {
   clipchildren 1
   ignorepointer 0
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
  }
  TextWidgetClass list_empty {
