PanelWidgetClass UIActionFeedbackButton {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style rover_sim_colorable
 scriptclass "UIActionFeedbackButton"
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    ButtonWidgetClass action_button {
     color 0 0 0 0
     style Empty
     ignorepointer 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     {
      PanelWidgetClass fill {
       ignorepointer 1
       position 0 0
       size 1 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       color 0.133 0.161 0.196 0.902
       style COTBox8Set
      }
      PanelWidgetClass outline {
       ignorepointer 1
       position 0 0
       size 1 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       color 0.925 0.976 1.000 0.502
       style COTBox8LineSet
      }
      ImageWidgetClass action_icon {
       visible 0
       ignorepointer 1
       position 10 0
       size 16 16
       halign left_ref
       valign center_ref
       hexactpos 1
       vexactpos 0
       hexactsize 1
       vexactsize 1
       mode blend
       "src alpha" 1
       "no wrap" 1
       "clamp mode" clamp
       "stretch mode" stretch_w_h
      }
      TextWidgetClass action {
       ignorepointer 1
       position 0 0
       size 1 1
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       style Light
       text "{BUTTON}"
       font "gui/fonts/sdf_MetronLight24"
       "exact text" 1
       "exact text size" 16
       "text halign" center
       "text valign" center
      }
     }
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0.082 0.098 0.118 0.651
   style COTField4Set
  }
 }
}
