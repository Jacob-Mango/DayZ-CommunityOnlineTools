PanelWidgetClass UIActionCard {
 color 0.133 0.161 0.196 0.902
 size 1 1
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 style COTBox8Set
 scriptclass "UIActionCard"
 {
  PanelWidgetClass card_header {
   ignorepointer 1
   position 0 0
   size 1 30
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   color 0.082 0.098 0.118 0.941
   style COTBox8Set
   {
    PanelWidgetClass card_header_rule {
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign bottom_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 1
     color 0.925 0.976 1.000 0.180
    }
    TextWidgetClass card_title {
     ignorepointer 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Light
     text "{TITLE}"
     font "gui/fonts/sdf_MetronLight24"
     "text offset" 12 0
     "bold text" 1
     "exact text" 1
     "exact text size" 16
     "text valign" center
    }
   }
  }
  GridSpacerWidgetClass card_content {
   ignorepointer 0
   position 0 36
   size 0.955 1
   halign center_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 1
   Rows 20
   Padding 0
  }
  WrapSpacerWidgetClass card_header_actions {
   ignorepointer 0
   position 6 0
   size 160 30
   halign right_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
  }
  PanelWidgetClass card_ring {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0.925 0.976 1.000 0.180
   style COTBox8LineSet
  }
 }
}
