PanelWidgetClass icon_cell {
 size 40 40
 hexactsize 1
 vexactsize 1
 color 0 0 0 0
 {
  ButtonWidgetClass action_button {
   color 0 0 0 0
   style Empty
   ignorepointer 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    PanelWidgetClass fill {
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     color 0.133 0.161 0.196 0.902
     style COTBox8Set
    }
    PanelWidgetClass outline {
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     color 0.925 0.976 1.000 0.502
     style COTBox8LineSet
    }
    ImageWidgetClass action_image {
     ignorepointer 1
     size 16 16
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     "src alpha" 1
     "no wrap" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
    }
   }
  }
 }
}
