ButtonWidgetClass tab_btn {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 style Empty
 {
  PanelWidgetClass fill {
   ignorepointer 1
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0.133 0.161 0.196 1.000
   style COTBox8Set
  }
  PanelWidgetClass outline {
   visible 0
   ignorepointer 1
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0.569 0.584 1.000 1.000
   style COTBox8LineSet
  }
  ImageWidgetClass icon {
   visible 0
   ignorepointer 1
   position 10 0
   size 16 16
   halign left_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 1 1 1
   mode blend
   "src alpha" 1
   "no wrap" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  TextWidgetClass label {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text ""
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 14
   "text halign" center
   "text valign" center
  }
 }
}
