PanelWidgetClass UIActionBadge {
 color 0 0 0 0
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 scriptclass "UIActionBadge"
 style rover_sim_colorable
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    TextWidgetClass action_label {
     size 1 20
     valign center_ref
     vexactsize 1
     text "{LABEL}"
     font "gui/fonts/sdf_MetronLight24"
     "text offset" 10 0
     "bold text" 1
     "exact text" 1
     "exact text size" 16
     "text valign" center
    }
    PanelWidgetClass action_pill {
     color 0.000 0.298 0.224 1.000
     position 0 0
     size 80 20
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style COTPill10Set
     {
      TextWidgetClass action {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "{STATUS}"
       font "gui/fonts/sdf_MetronLight24"
       "bold text" 1
       "exact text" 1
       "exact text size" 12
       "text halign" center
       "text valign" center
      }
     }
    }
   }
  }
  ButtonWidgetClass action_button {
   visible 0
   color 0 0 0 0
   style Empty
   ignorepointer 0
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}