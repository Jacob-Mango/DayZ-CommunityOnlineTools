PanelWidgetClass UIActionStagedIcon {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 scriptclass "UIActionStagedIcon"
 {
  ButtonWidgetClass action_button {
   ignorepointer 0
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0 0 0 0
   {
    ImageWidgetClass action_image {
     ignorepointer 1
     position 0 0
     size 16 16
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     "src alpha" 1
     "no wrap" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.098 0.118 0.141 0.996
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style COTField4Set
  }
 }
}
