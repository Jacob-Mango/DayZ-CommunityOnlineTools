PanelWidgetClass UIActionPaginator {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style rover_sim_colorable
 scriptclass "UIActionPaginator"
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    ButtonWidgetClass action_button_prev {
     ignorepointer 0
     size 30 24
     halign left_ref
     valign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      PanelWidgetClass fill {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       color 0.133 0.161 0.196 0.400
       style COTField4Set
      }
      TextWidgetClass prev_text {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "<"
       font "gui/fonts/sdf_MetronLight24"
       "exact text" 1
       "exact text size" 16
       "text halign" center
       "text valign" center
      }
     }
    }
    TextWidgetClass action {
     ignorepointer 1
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "1 / 1"
     font "gui/fonts/sdf_MetronLight24"
     "exact text" 1
     "exact text size" 14
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass action_button_next {
     ignorepointer 0
     size 30 24
     halign right_ref
     valign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      PanelWidgetClass fill {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       color 0.133 0.161 0.196 0.400
       style COTField4Set
      }
      TextWidgetClass next_text {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text ">"
       font "gui/fonts/sdf_MetronLight24"
       "exact text" 1
       "exact text size" 16
       "text halign" center
       "text valign" center
      }
     }
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}
