PanelWidgetClass UIActionCollapsibleSection {
 color 0 0 0 0
 size 1 1
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 scriptclass "UIActionCollapsibleSection"
 style rover_sim_colorable
 {
  GridSpacerWidgetClass action_wrapper {
   ignorepointer 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   Columns 1
   Rows 2
   Padding 0
   {
    ButtonWidgetClass action_button {
     ignorepointer 0
     size 1 30
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 1
     {
      PanelWidgetClass fill {
       ignorepointer 1
       color 0.133 0.161 0.196 0.600
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style COTField4Set
      }
      PanelWidgetClass border_bottom {
       ignorepointer 1
       color 0.133 0.161 0.196 1.000
       size 1 2
       halign left_ref
       valign bottom_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 1
       style rover_sim_colorable
      }
      TextWidgetClass action_label {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "{TITLE}"
       font "gui/fonts/sdf_MetronLight24"
       "text offset" 10 0
       "bold text" 1
       "exact text" 1
       "exact text size" 16
       "text valign" center
      }
      ImageWidgetClass action_arrow {
       ignorepointer 1
       position 8 0
       size 16 16
       halign right_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:dayz_gui image:icon_expand"
       mode blend
       "src alpha" 1
       "clamp mode" clamp
       rotation 0 0 90
      }
     }
    }
    PanelWidgetClass action_content {
     visible 1
     ignorepointer 0
     color 0 0 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     "Size To Content V" 1
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}
