     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "{LABEL}"
     font "gui/fonts/sdf_MetronLight24"
     "text offset" 10 0
     "bold text" 1
     "exact text" 1
     "exact text size" 16
     "text valign" center
    }
    FrameWidgetClass action_fields {
     ignorepointer 0
     size 0.6 1
     halign right_ref
