PanelWidgetClass UIActionTimePicker {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style rover_sim_colorable
 scriptclass "UIActionTimePicker"
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
