PanelWidgetClass UIActionImageButton {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style rover_sim_colorable
 scriptclass "UIActionImageButton"
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    ButtonWidgetClass action_button {
     ignorepointer 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     {
      PanelWidgetClass fill {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       halign left_ref
       valign top_ref
       color 0.04 0.04 0.12 0.4
       style rover_sim_colorable
      }
      PanelWidgetClass border_top {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 1
       halign left_ref
       valign top_ref
       color 0.042 0.056 0.077 0.5
       style rover_sim_colorable
      }
      PanelWidgetClass border_left {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 1
       vexactsize 0
       halign left_ref
       valign top_ref
       color 0.042 0.056 0.077 0.5
       style rover_sim_colorable
      }
      PanelWidgetClass border_bottom {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 1
       halign left_ref
       valign bottom_ref
       color 0.042 0.056 0.077 0.5
       style rover_sim_colorable
      }
      PanelWidgetClass border_right {
       ignorepointer 1
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 1
       vexactsize 0
       halign right_ref
       valign top_ref
       color 0.042 0.056 0.077 0.5
       style rover_sim_colorable
      }
      ImageWidgetClass action_image {
       ignorepointer 1
       size 16 16
       halign center_ref
       valign center_ref
       hexactsize 1
       vexactsize 1
       mode blend
       "src alpha" 1
       "no wrap" 1
       stretch 0
       image0 "set:dayz_gui image:icon_x"
      }
     }
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.1569 0.1569 0.1569 0.902
   position 0 0
   size 1 1
   style rover_sim_colorable
  }
 }
}