PanelWidgetClass UIActionToggle {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style rover_sim_colorable
 scriptclass "UIActionToggle"
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    ButtonWidgetClass action_button {
     ignorepointer 0
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Empty
    }
    PanelWidgetClass action_box_square {
     visible 0
     ignorepointer 1
     position 4 0
     size 12 12
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     color 0.722 0.769 0.792 1.000
     "src alpha" 1
     "no wrap" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
     style COTField4Set
    }
    ImageWidgetClass action_check {
     visible 0
     ignorepointer 1
     position 6 0
     size 8 8
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     color 0.376 0.365 1.000 1.000
     "src alpha" 1
     "no wrap" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
    }
    ImageWidgetClass action_box_round {
     visible 0
     ignorepointer 1
     position 6 0
     size 14 14
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     color 0.722 0.769 0.792 1.000
     image0 "set:cot_gui image:circle_line"
     "src alpha" 1
     "no wrap" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
    }
    ImageWidgetClass action_check_image {
     visible 0
     ignorepointer 1
     position 9 0
     size 8 8
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     mode blend
     color 0.376 0.365 1.000 1.000
     image0 "set:cot_gui image:circle_fill"
     "src alpha" 1
     "no wrap" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
    }
    TextWidgetClass action_label {
     ignorepointer 1
     position 0 0
     size 1 20
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 0
     vexactsize 1
     text ""
     font "gui/fonts/sdf_MetronLight24"
     "bold text" 1
     "exact text" 1
     "exact text size" 16
     "text valign" center
     "text offset" 31 0
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}
