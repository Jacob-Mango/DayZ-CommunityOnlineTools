PanelWidgetClass UIActionItemListRow {
 ignorepointer 0
 position 0 0
 size 1 22
 halign left_ref
 valign top_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style COTField4Set
 {
  //! Left-edge marker, transparent by default. A host that tracks a
  //! selection state distinct from the list's own click-highlight (e.g.
  //! ESP's multi-select object list) can light this up per row without
  //! disturbing COLOR_ROW_SELECTED, which is the list's single "row you
  //! last clicked/pressed" indicator, not a data selection.
  PanelWidgetClass row_accent {
   ignorepointer 1
   color 0 0 0 0
   position 0 0
   size 3 1
   halign left_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
  }
  //! Reserved gutter regardless of selection - only shown/hidden per row,
  //! never moved, so the text column next to it does not jump left and
  //! right as rows are selected and deselected. The gap to row_text's
  //! offset is deliberately wider than the icon needs: the icon's position
  //! and size scale with the player's UI scale while the text offset does
  //! not, so a tight gutter closed up and the tick sat on the label.
  ImageWidgetClass row_selected_icon {
   visible 0
   inheritalpha 0
   ignorepointer 1
   color 1 1 1 1
   position 5 0
   size 11 11
   valign center_ref
   hexactpos 1
   vexactpos 0
   hexactsize 1
   vexactsize 1
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
   filter 1
  }
  TextWidgetClass row_text {
   ignorepointer 1
   position 0 0
   size 0.66 1
   halign left_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   font "gui/fonts/sdf_MetronLight24"
   "text offset" 32 0
   "exact text" 1
   "exact text size" 13
   "text halign" left
   "text valign" center
  }
  TextWidgetClass row_sub {
   ignorepointer 1
   position 0 0
   size 0.33 1
   halign right_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   font "gui/fonts/sdf_MetronLight24"
   "text offset" -8 0
   "exact text" 1
   "exact text size" 11
   "text halign" right
   "text valign" center
  }
 }
}
