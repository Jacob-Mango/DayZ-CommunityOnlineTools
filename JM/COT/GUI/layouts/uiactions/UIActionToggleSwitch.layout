PanelWidgetClass UIActionToggleSwitch {
 color 0 0 0 0
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 scriptclass "UIActionToggleSwitch"
 style rover_sim_colorable
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    TextWidgetClass action_label {
     size 1 20
     valign center_ref
     vexactsize 1
     text "{LABEL}"
     font "gui/fonts/sdf_MetronLight24"
     "text offset" 10 0
     "bold text" 1
     "exact text" 1
     "exact text size" 16
     "text valign" center
    }
    ButtonWidgetClass action_button {
     ignorepointer 0
     position 0 0
     size 44 22
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Empty
     "no focus" 1
     {
      PanelWidgetClass action_track {
       ignorepointer 1
       color 0.133 0.161 0.196 1.000
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style COTPill11Set
      }
      ImageWidgetClass action_thumb {
       ignorepointer 1
       mode blend
       color 0.925 0.976 1.000 0.502
       position 2 0
       size 18 18
       halign left_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:cot_gui image:circle_fill"
       "src alpha" 1
       "no wrap" 1
       "clamp mode" clamp
       "stretch mode" stretch_w_h
      }
     }
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}
