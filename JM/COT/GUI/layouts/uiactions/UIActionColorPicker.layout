PanelWidgetClass UIActionColorPicker {
 color 0 0 0 0
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 scriptclass "UIActionColorPicker"
 style rover_sim_colorable
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    TextWidgetClass action_label {
     size 1 20
     valign center_ref
     vexactsize 1
     text "{LABEL}"
     font "gui/fonts/sdf_MetronLight24"
     "text offset" 10 0
     "bold text" 1
     "exact text" 1
     "exact text size" 16
     "text valign" center
    }
    ButtonWidgetClass action_preview_button {
     ignorepointer 0
     color 0 0 0 0
     position 4 0
     size 22 22
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Empty
     {
      PanelWidgetClass action_preview {
       ignorepointer 1
       color 1 1 1 1
       position 0 0
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style COTField4Set
      }
     }
    }
    PanelWidgetClass action_chrome {
     ignorepointer 0
     color 0 0 0 0
     position 30 0
     size 90 22
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      PanelWidgetClass action_fill {
       ignorepointer 1
       position 0 0
       size 1 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       color 0.082 0.098 0.118 0.941
       style COTField4Set
      }
      PanelWidgetClass action_ring {
       ignorepointer 1
       position 0 0
       size 1 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       color 0.925 0.976 1.000 0.502
       style COTField4LineSet
      }
      EditBoxWidgetClass action {
       position 0 0
       size 1 1
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       ignorepointer 0
       "exact text" 1
       font "gui/fonts/sdf_MetronLight24"
       "text halign" left
       "text offset" 8 0
       style COTInput
      }
     }
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}