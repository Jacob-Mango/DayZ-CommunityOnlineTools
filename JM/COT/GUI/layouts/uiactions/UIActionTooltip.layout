PanelWidgetClass UIActionTooltip {
 visible 0
 ignorepointer 1
 position 0 0
 size 100 22
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 clipchildren 0
 priority 10000
 color 0.098 0.118 0.141 0.950
 style COTBox8Set
 {
  PanelWidgetClass border {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0.133 0.161 0.196 1.000
   style COTBox8LineSet
  }
  PanelWidgetClass tooltip_swatch {
   visible 0
   ignorepointer 1
   position 5 4
   size 14 14
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 1 1 1
   style COTField4Set
  }
  ImageWidgetClass tooltip_icon {
   visible 0
   ignorepointer 1
   position 5 3
   size 16 16
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   mode blend
   color 1 1 1 1
   "src alpha" 1
   "no wrap" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  PanelWidgetClass tooltip_text_container {
   ignorepointer 1
   position 6 6
   size 88 10
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0 0 0 0
   {
    RichTextWidgetClass tooltip_text {
     ignorepointer 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     font "gui/fonts/sdf_MetronLight24"
     "exact text" 1
     "exact text size" 13
     "text halign" left
     "text valign" top
     "size to text v" 1
     wrap 1
    }
   }
  }
 }
}
