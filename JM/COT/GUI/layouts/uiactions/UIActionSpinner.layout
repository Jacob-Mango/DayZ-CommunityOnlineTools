PanelWidgetClass UIActionSpinner {
 size 1 30
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0 0 0 0
 style rover_sim_colorable
 scriptclass "UIActionSpinner"
 {
  FrameWidgetClass action_wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    TextWidgetClass action_label {
     size 0.45 1
     halign left_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "{LABEL}"
     font "gui/fonts/sdf_MetronLight24"
     "text offset" 10 0
     "bold text" 1
     "exact text" 1
     "exact text size" 16
     "text valign" center
    }
    FrameWidgetClass action_controls {
     ignorepointer 1
     size 92 1
     halign right_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 1
     vexactsize 0
     {
      PanelWidgetClass action_chrome {
       ignorepointer 0
       color 0 0 0 0
       position 0 0
       size 1 24
       halign left_ref
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 1
       {
        PanelWidgetClass action_fill {
         ignorepointer 1
         position 0 0
         size 1 1
         halign left_ref
         valign top_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         color 0.082 0.098 0.118 0.941
         style COTField4Set
        }
        PanelWidgetClass action_ring {
         ignorepointer 1
         position 0 0
         size 1 1
         halign left_ref
         valign top_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         color 0.925 0.976 1.000 0.502
         style COTField4LineSet
        }
        EditBoxWidgetClass action {
         position 0 0
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         ignorepointer 0
         font "gui/fonts/sdf_MetronLight24"
         "exact text" 1
         "exact text size" 16
         "text halign" center
         "text offset" 0 0
         style COTInput
        }
       }
      }
      ButtonWidgetClass action_button_dec {
       ignorepointer 0
       position 0 0
       size 14 24
       halign left_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        PanelWidgetClass fill {
         ignorepointer 1
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         color 0.133 0.161 0.196 0.400
         style COTField4Set
        }
        TextWidgetClass dec_text {
         ignorepointer 1
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         text "-"
         font "gui/fonts/sdf_MetronLight24"
         "exact text" 1
         "exact text size" 16
         "text halign" center
         "text valign" center
        }
       }
      }
      ButtonWidgetClass action_button_inc {
       ignorepointer 0
       position 0 0
       size 14 24
       halign right_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        PanelWidgetClass fill {
         ignorepointer 1
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         color 0.133 0.161 0.196 0.400
         style COTField4Set
        }
        TextWidgetClass inc_text {
         ignorepointer 1
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         text "+"
         font "gui/fonts/sdf_MetronLight24"
         "exact text" 1
         "exact text size" 16
         "text halign" center
         "text valign" center
        }
       }
      }
     }
    }
   }
  }
  PanelWidgetClass action_wrapper_disable {
   visible 0
   clipchildren 0
   ignorepointer 0
   color 0.082 0.098 0.118 0.902
   position 0 0
   size 1 1
   style COTField4Set
  }
 }
}
