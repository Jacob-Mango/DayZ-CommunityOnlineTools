ButtonWidgetClass UIActionDropdownRow {
 size 1 28
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 color 0.133 0.161 0.196 0.900
 style COTField4Set
 {
  ImageWidgetClass row_icon {
   visible 0
   ignorepointer 1
   position 4 0
   size 16 16
   halign left_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   mode blend
   "src alpha" 1
   "no wrap" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  TextWidgetClass row_text {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 0
   halign left_ref
   valign center_ref
   style Light
   font "gui/fonts/sdf_MetronLight24"
   "text offset" 40 0
   "exact text" 1
   "exact text size" 14
   "text halign" left
   "text valign" center
  }
 }
}
