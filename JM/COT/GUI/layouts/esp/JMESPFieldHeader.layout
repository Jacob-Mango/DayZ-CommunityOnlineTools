PanelWidgetClass JMESPFieldHeader {
 color 0 0 0 0
 position 0 0
 size 1 28
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 {
  TextWidgetClass field_label {
   position 10 0
   size 0.6 1
   halign left_ref
   valign center_ref
   hexactpos 1
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text "{LABEL}"
   font "gui/fonts/sdf_MetronLight72"
   "bold text" 1
   "exact text" 1
   "exact text size" 16
   "text halign" left
   "text valign" center
  }
  PanelWidgetClass field_buttons {
   ignorepointer 1
   color 0 0 0 0
   position -10 0
   size 96 28
   halign right_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
  }
 }
}
