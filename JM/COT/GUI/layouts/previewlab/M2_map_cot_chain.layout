PanelWidgetClass lab_host {
 color 0 0 0 0
 position 0 0
 size 1 200
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 {
  WindowWidgetClass lab_window {
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Default
   {
    PanelWidgetClass lab_back {
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style blank
     {
      MapWidgetClass lab_map {
       visible 1
       ignorepointer 0
       position 0 0
       size 1 1
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
      }
    }
   }
  }
 }
}
