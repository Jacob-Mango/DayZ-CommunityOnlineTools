PanelWidgetClass lab_host {
 color 0 0 0 0
 position 0 0
 size 1 200
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 priority 50
 {
  WindowWidgetClass lab_window {
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_black
   {
    PanelWidgetClass lab_bg {
     ignorepointer 1
     position 0 0
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     draggable 0
     style rover_sim_colorable
    }
    PanelWidgetClass lab_back {
     color 0.4706 0.4706 0.4706 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style rover_sim_black
     {
      MapWidgetClass lab_map {
       visible 1
       clipchildren 1
       inheritalpha 0
       ignorepointer 0
       position 0 0
       size 1 1
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
      }
    }
   }
  }
 }
}
