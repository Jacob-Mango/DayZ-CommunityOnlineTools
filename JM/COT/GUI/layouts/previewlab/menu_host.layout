PanelWidgetClass menu_host {
 color 0.082 0.098 0.118 0.902
 position 0 0
 size 1 1
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  TextWidgetClass lab_title {
   ignorepointer 1
   position 40 30
   size 900 24
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style Light
   text "H3 - same widgets inside a real UIScriptedMenu"
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 18
   "text valign" center
  }
  ButtonWidgetClass lab_close {
   position -40 30
   size 120 30
   halign right_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "Close"
  }
  PanelWidgetClass lab_preview_host {
   color 0 0 0 0
   position 40 80
   size 160 160
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style blank
   {
    ItemPreviewWidgetClass lab_preview {
     visible 0
     clipchildren 1
     inheritalpha 0
     ignorepointer 1
     color 0.702 0.702 0.702 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     scaled 1
     priority 151
    }
   }
  }
  PanelWidgetClass lab_map_host {
   color 0 0 0 0
   position 240 80
   size 512 512
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    MapWidgetClass lab_map {
     visible 1
     ignorepointer 0
     position 0 0
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
    }
   }
  }
 }
}
