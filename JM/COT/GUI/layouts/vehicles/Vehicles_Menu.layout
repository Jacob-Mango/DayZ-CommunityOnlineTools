PanelWidgetClass JMVehiclesForm {
 ignorepointer 1
 color 0 0 0 0
 position 0 0
 size 1081 600
 hexactpos 0
 vexactpos 0
 hexactsize 1
 vexactsize 1
 draggable 1
 scriptclass "JMVehiclesForm"
 style DayZDefaultPanel
 {
  PanelWidgetClass vehicles_window_panel {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    PanelWidgetClass vehicles_list_panel {
     ignorepointer 1
     color 0 0 0 1
     position 0 0
     size 0.35 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style DayZDefaultPanel
     {
      PanelWidgetClass vehicles_list_label_panel {
       ignorepointer 1
       position 0 0
       size 1 20
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style blank
       {
        TextWidgetClass vehicles_list_label {
         ignorepointer 1
         position 0 0
         size 1 1
         hexactpos 1
         vexactpos 1
         hexactsize 0
         vexactsize 0
         style Bold
         text "#STR_COT_VEHICLE_LIST_TITLE"
         "text halign" center
         "text valign" center
        }
       }
      }
      ScrollWidgetClass vehicles_list_scroller {
       ignorepointer 0
       position 0 20
       size 1 400
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style blank
       "Scrollbar V" 1
       {
        WrapSpacerWidgetClass vehicles_list_content {
         position 0 0
         size 1 1
         hexactpos 1
         vexactpos 1
         hexactsize 0
         vexactsize 0
         "Size To Content V" 1
        }
       }
      }
      PanelWidgetClass vehicles_list_buttons {
       ignorepointer 1
       size 1 175
       valign bottom_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style blank
      }
     }
    }
    PanelWidgetClass map_window_panel {
     ignorepointer 0
