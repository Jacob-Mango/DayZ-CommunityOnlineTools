PanelWidgetClass JMVehiclesListEntry {
 visible 1
 clipchildren 1
 ignorepointer 1
 color 0 0 0 0
 position 0 0
 size 1 28
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
