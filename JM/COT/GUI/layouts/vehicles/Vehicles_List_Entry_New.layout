 vexactsize 1
 scriptclass ""
 {
  PanelWidgetClass row_fill {
   ignorepointer 1
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0 0 0 0.3922
   style COTField4Set
  }
  ButtonWidgetClass edit_button {
   clipchildren 1
   ignorepointer 0
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Empty
   {
    ImageWidgetClass vehicle_status_icon {
     visible 1
     ignorepointer 1
     keepsafezone 0
     color 1.000 0.384 0.490 1.000
     position 10 0
     size 10 10
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     image0 "set:dayz_gui image:circle"
     mode blend
     "src alpha" 1
     "no wrap" 0
     stretch 0
    }
    WrapSpacerWidgetClass vehicle_entry_content {
     ignorepointer 1
     clipchildren 1
     position 28 0
     size 0.92 1
     halign left_ref
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 0
     vexactsize 0
     Padding 0
     Margin 0
     content_valign center
     {
      TextWidgetClass vehicle_name {
       clipchildren 1
       ignorepointer 1
       keepsafezone 0
       position 0 0
       size 0.3 20
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 1
       text "Vehicle Name"
       font "gui/fonts/sdf_MetronLight24"
       "exact text" 1
       "exact text size" 15
       "size to text h" 1
       "size to text v" 0
       "text valign" center
      }
      TextWidgetClass vehicle_id {
       clipchildren 1
