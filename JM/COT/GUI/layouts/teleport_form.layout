PanelWidgetClass JMTeleportForm {
 color 0 0 0 0
 position 0 0
 size 400 510
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 scriptclass "JMTeleportForm"
 style DayZDefaultPanel
 {
  GridSpacerWidgetClass actions_filter_wrapper {
   position 0 0
   priority 20
   size 1 30
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   "Size To Content V" 1
   Columns 1
   Rows 2
  }
  TextListboxWidgetClass tls_ppp_pm_positions_list {
   visible 1
   priority 10
   position 0 30
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   style Editor
   lines 20
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 16
  }
  GridSpacerWidgetClass actions_wrapper {
   position 0 0
   size 1 60
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   valign bottom_ref
   "Size To Content V" 1
   Columns 1
   Rows 3
  }
 }
}
